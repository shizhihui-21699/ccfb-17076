<div class="card">
  <h2>密码登录</h2>
  <%= form_with url: login_path, local: true do |f| %>
    <p><%= f.label :email %><br><%= f.email_field :email, required: true %></p>
    <p><%= f.label :password %><br><%= f.password_field :password, required: true %></p>
    <p><%= f.submit '登录', class: 'btn' %></p>
  <% end %>
</div>
