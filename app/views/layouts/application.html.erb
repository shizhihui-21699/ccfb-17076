<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>OAuthGuard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: -apple-system, sans-serif; margin: 0; background: #f5f6f8; color: #1f2933; }
    .bar { background: #102a43; color: #fff; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
    .bar a { color: #9fb3c8; margin-left: 16px; text-decoration: none; }
    .wrap { max-width: 860px; margin: 32px auto; padding: 0 20px; }
    .card { background: #fff; border-radius: 10px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .btn { display: inline-block; padding: 10px 18px; border-radius: 8px; background: #2b6cb0; color: #fff; text-decoration: none; border: 0; cursor: pointer; font-size: 14px; }
    .btn.danger { background: #c53030; } .btn.gray { background: #627d98; }
    .flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
    .flash.notice { background: #e6fffa; border: 1px solid #81e6d9; }
    .flash.alert { background: #fff5f5; border: 1px solid #feb2b2; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e4e7eb; }
    .tag { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; }
    .tag.verified { background: #c6f6d5; } .tag.unverified, .tag.unknown { background: #fed7d7; }
    .tag.quarantined { background: #feebc8; } .tag.active { background: #bee3f8; }
    input { padding: 8px 10px; border: 1px solid #cbd2d9; border-radius: 6px; font-size: 14px; }
    .muted { color: #627d98; font-size: 13px; }
  </style>
</head>
<body>
  <div class="bar">
    <strong>OAuthGuard · 安全第三方登录演示</strong>
    <nav>
      <%= link_to '首页', root_path %>
      <% if logged_in? %>
        <%= link_to '账号设置', account_path %>
        <%= button_to '退出', logout_path, method: :post, style: 'display:inline' %>
      <% else %>
        <%= link_to '密码登录', login_path %>
      <% end %>
    </nav>
  </div>
  <div class="wrap">
    <% flash.each do |type, msg| %>
      <div class="flash <%= type %>"><%= msg %></div>
    <% end %>
    <%= yield %>
  </div>
</body>
</html>
